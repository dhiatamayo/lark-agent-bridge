# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# --- Lark credentials -----------------------------------------------------
# From the Lark/Feishu Developer Console > your app > Credentials & Basic Info
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "lark" (open.larksuite.com, international) or "feishu" (open.feishu.cn)
LARK_DOMAIN=lark

# --- Access control -------------------------------------------------------
# Comma-separated Lark open_ids allowed to use the bot.
# Leave empty on first run: the bot replies with your open_id so you can fill it.
# The agent can run tools on this machine, so never leave this open in prod.
ALLOWED_OPEN_IDS=

# In group chats, only reply when the bot is @mentioned specifically (ignores
# @all and mentions of other people). The bot's open_id is auto-resolved from
# the API at startup; set it here only to skip that call. Set
# GROUP_REQUIRE_BOT_MENTION=0 to reply on any group mention (old behaviour).
BOT_OPEN_ID=
GROUP_REQUIRE_BOT_MENTION=1

# --- Agent engine ---------------------------------------------------------
# Which backend drives the bot: "kiro" (kiro-cli), "agy" (antigravity CLI),
# or "copilot" (GitHub Copilot CLI).
# Switchable at runtime from Lark too: /engine agy | /engine kiro | /engine copilot
AGENT_ENGINE=kiro
# Optional explicit binary paths (auto-detected from PATH when empty).
KIRO_BIN=
AGY_BIN=
COPILOT_BIN=

# Folder the agent works in (conversation history is kept per folder).
AGENT_WORKDIR=.
# Tools the agent may use without asking: "read,grep" (read-only), a custom
# comma list, or "all". NOTE: kiro supports granular lists; agy and copilot are
# all-or-nothing (copilot runs with --allow-all-tools, required non-interactively).
AGENT_TRUST_TOOLS=read,grep
# Optional custom agent name (passed to --agent on all engines).
AGENT_NAME=
# Subprocess timeout for a single agent run, in seconds.
AGENT_TIMEOUT_SEC=600
# "final" = only the agent's final answer, "all" = include in-between narration.
AGENT_REPLY_MODE=final

# --- agy-specific (optional) ----------------------------------------------
AGY_MODEL=
AGY_EFFORT=

# --- copilot-specific (optional) ------------------------------------------
# Model (e.g. 'auto', 'gpt-5.4', 'claude-sonnet-5.5'); empty => copilot default.
COPILOT_MODEL=
# Reasoning effort: none|minimal|low|medium|high|xhigh|max; empty => default.
COPILOT_EFFORT=

# --- UI / behaviour -------------------------------------------------------
# How many recent transcript entries to inject as context on an engine switch.
ENGINE_SWITCH_CONTEXT_LINES=20
# Emoji reaction shown on your message while the agent works (Lark emoji_type).
LARK_TYPING_EMOJI=Typing
# Where transcripts are written (defaults to ./transcripts).
# LARK_TRANSCRIPT_DIR=

# --- Observability: log access tool (optional, OFF by default) ------------
# Lets /logs and /projects read logs from OpenObserve (and later Grafana).
# Additive & gated: leave ENABLE_OBSERVABILITY=0 and the bot behaves as before.
ENABLE_OBSERVABILITY=0
# Project registry (pointer per project -> backend/org/stream). JSON file kept
# OUTSIDE version control (it describes internal infra). See DESIGN_observability.md.
# OBSERVABILITY_REGISTRY=./observability_registry.json
# OpenObserve base URL, e.g. https://openobserve.example.com
# OPENOBSERVE_BASE_URL=
# Encrypted secret store (created via the SecretStore API; see secrets.py).
# Credentials live here encrypted — NOT in this file.
# LAB_SECRETS_PATH=./secrets.enc
# The AES key that unlocks the store. Keep it OUTSIDE the repo. Provide EITHER
# an env var LAB_SECRET_KEY (base64 of 32 bytes) OR a key file:
# LAB_SECRET_KEY_FILE=~/.lab/secret.key
# Default max log rows returned to chat (hard-capped at 200 in the client).
# LOGS_DEFAULT_LIMIT=50
# Timezone offset (hours from UTC) for absolute timestamps in
# `/logs <project> from <date> to <date>`. OpenObserve stores UTC; you type
# wall-clock time. Default 7 = WIB (Asia/Jakarta).
# LOGS_TZ_OFFSET_HOURS=7
